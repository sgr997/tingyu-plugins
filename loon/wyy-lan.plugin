#!name = 听屿网易云局域网切换
#!desc = 把听屿网易云插件的 API 请求按网络分流：在家走局域网，在外走公网。插件里不含任何地址或端口，公网/局域网地址只填在本机参数里。HTTP 无需 MITM 证书；局域网请求明文传输 Token/Cookie，仅用于可信网络。
#!author = 听屿
#!homepage = https://github.com/sgr997/tingyu-plugins
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
homeWifi = input,"",tag=家庭 Wi-Fi 名称,desc=多个 SSID 用英文或中文逗号分隔；留空时一律走公网
publicBase = input,"",tag=公网 API 地址,desc=只保存在本机 Loon 配置里，不会进入仓库；留空时无法在外网使用
lanBase = input,"",tag=局域网 API 地址,desc=只保存在本机 Loon 配置里；留空时在家也走公网

[Script]
request if ${url} ~= /^http:\/\/wyy-api\.invalid(?:\/|$)/i then script("https://raw.githubusercontent.com/sgr997/tingyu-plugins/main/loon/wyy-lan.js", {${homeWifi}, ${publicBase}, ${lanBase}}) with tag="网易云局域网切换", timeout=40, requires_body=true, binary_body_mode=true
