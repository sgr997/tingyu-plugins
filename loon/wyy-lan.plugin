#!name = 听屿网易云局域网切换
#!desc = 指定 Wi-Fi 下将网易云 API 请求转到局域网，其他网络保持公网地址。需要开启 MITM 并信任 Loon 证书。HTTP 局域网请求会明文传输 API Token 和 Cookie，仅用于可信网络。
#!author = 听屿
#!homepage = https://github.com/sgr997/tingyu-plugins
#!loon_version = 3.5.1(983)
#!type = normal

[Argument]
homeWifi = input,"",tag=家庭 Wi-Fi 名称,desc=多个 SSID 用英文或中文逗号分隔；留空时保持公网请求
lanBase = input,"",tag=局域网 API 地址,desc=填写包含协议和端口的局域网地址；留空时保持公网请求

[Script]
request if ${url} ~= /^https:\/\/wyy\.goku\.top(?:\/|$)/i then script("https://raw.githubusercontent.com/sgr997/tingyu-plugins/main/loon/wyy-lan.js", {${homeWifi}, ${lanBase}}) with tag="网易云局域网切换"

[Mitm]
hostname = wyy.goku.top
